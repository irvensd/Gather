# Public client configuration. These values are safe to ship because Row Level Security is required.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_BIBLE_API_URL=https://bible-api.com

# Server-only. Never prefix these with EXPO_PUBLIC and never commit real values.
# Used by `npm run test:integration` against an isolated test project.
SUPABASE_TEST_URL=
SUPABASE_TEST_SECRET_KEY=
